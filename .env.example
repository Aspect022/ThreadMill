# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
# Required for AI-powered learning path generation
GOOGLE_GENERATIVE_AI_API_KEY=your_google_gemini_api_key_here

# Alternative environment variable name (either one works)
Gemini_API=your_google_gemini_api_key_here

# Note: Only one of the above is required. The application checks both.
# If neither is set, the AI Demo section will use fallback mock data.
